<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solo l'app del modulo (stessa firma) puo' chiedere a system_server di
         riapplicare subito le impostazioni (densita' del monitor, tieni acceso). -->
    <permission
        android:name="io.maurizio.hyperdesktop.permission.APPLY_SETTINGS"
        android:protectionLevel="signature" />
    <uses-permission android:name="io.maurizio.hyperdesktop.permission.APPLY_SETTINGS" />
    <!-- Solo l'app (SettingsActivity) la usa, per il controllo aggiornamenti su GitHub -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_manage"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- Metadati riconosciuti da LSPosed -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_desc" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
        <!-- Preferenze dell'app leggibili dagli hook (XSharedPreferences di LSPosed) -->
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />

        <!-- Impostazioni: dal cassetto app e dal pulsante del modulo in LSPosed -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- Riquadri delle impostazioni rapide: Computer <-> Mirroring e Touchpad -->
        <service
            android:name=".MonitorTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_monitor"
            android:label="@string/tile_monitor"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name=".TouchpadTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_touchpad"
            android:label="@string/tile_touchpad"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Salva gli screenshot del monitor per conto di system_server.
             INTERACT_ACROSS_USERS_FULL: le app di terze parti non possono
             ottenerlo, il sistema lo supera sempre. -->
        <provider
            android:name=".ShotProvider"
            android:authorities="io.maurizio.hyperdesktop.shots"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
